@inbook{Dubrow2016,
author = {Robert P. Dobrow},
publisher = {John Wiley & Sons, Ltd},
isbn = {9781118740712},
title = {Branching Processes},
booktitle = {Introduction to Stochastic Processes With R},
chapter = {4},
pages = {158-180},
doi = {https://doi.org/10.1002/9781118740712.ch4},
url = {https://onlinelibrary.wiley.com/doi/abs/10.1002/9781118740712.ch4},
eprint = {https://onlinelibrary.wiley.com/doi/pdf/10.1002/9781118740712.ch4},
year = {2016},
keywords = {branching processes, extinction probability, Markov chain, mean generration size, probability generating functions, stochastic processes},
abstract = {Summary Branching processes are a class of stochastic processes that model the growth of populations. They are widely used in biology and epidemiology to study the spread of infectious diseases and epidemics. Applications include nuclear chain reactions and the spread of computer software viruses. This chapter discusses the branching processes in detail. A branching process is a Markov chain since the size of a generation only depends on the size of the previous generation and the number of their offspring. In a branching process, the size of the nth generation is the sum of the total offspring of the individuals of the previous generation. The chapter explains to find the mean of the size of the nth generation. It also describes probability generating functions. Probability generating functions are especially useful for analyzing branching processes. The chapter uses them to find the probability that a branching process eventually goes extinct.}
}

